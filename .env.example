# Supabase
# Project URL จาก Dashboard → Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...) — ใช้ฝั่ง frontend ได้ ปลอดภัยพอที่จะเปิดเผย
# แทนที่ anon key แบบเก่า (JWT ที่ขึ้นต้นด้วย eyJ...)
# ชื่อตัวแปรยังเป็น SUPABASE_KEY เพราะ @nuxtjs/supabase อ่านชื่อนี้
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Secret key (sb_secret_...) — ใช้เฉพาะ server-side เท่านั้น (bypass RLS)
# แทนที่ service_role key แบบเก่า — ห้ามใส่ใน frontend / commit ขึ้น git
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx

# App
NUXT_PUBLIC_APP_URL=http://localhost:5100
NUXT_DEV_PORT=5100

# OneSignal Web Push — temporarily disabled (service worker conflicts with PWA)
# NUXT_PUBLIC_ONESIGNAL_APP_ID=
